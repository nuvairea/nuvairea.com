---
import { Image } from 'astro:assets';
import type { AlsoBuilt } from '../data/projects';

interface Props {
  item: AlsoBuilt;
}

const { item } = Astro.props;
---

<article class='also'>
  <div class='left'>
    <div class='eye'>Also built</div>
    <div class='photo'>
      <div class='shot'>
        <Image src={item.screenshot.src} alt={item.screenshot.alt} widths={[320, 640, 960]} sizes='(min-width: 761px) 300px, 100vw' />
      </div>
    </div>
  </div>

  <div class='body'>
    <h3 class='name'>{item.name}</h3>
    <p class='desc lead'>{item.description}</p>
    <div class='stack'>
      {item.stack.map((s) => (
        <span>{s}</span>
      ))}
    </div>
    <div class='actions'>
      <a class='pbtn f' href={item.liveUrl} target='_blank' rel='noopener noreferrer'>
        <svg aria-hidden='true' viewBox='0 0 24 24' width='18' height='18' fill='currentColor'>
          <use href='/icons/external.svg#icon'></use>
        </svg>
        <span>Visit {item.name}</span>
      </a>
      <a class='pbtn' href={item.codeUrl} target='_blank' rel='noopener noreferrer'>
        <svg aria-hidden='true' viewBox='0 0 16 16' width='18' height='18' fill='currentColor'>
          <use href='/icons/github.svg#icon'></use>
        </svg>
        <span>View code</span>
      </a>
    </div>
  </div>
</article>

<style>
  .also {
    display: grid;
    grid-template-columns: 480px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    margin-top: 72px;
    padding-top: 48px;
    border-top: 1px solid var(--line);
  }

  .left {
    min-width: 0;
  }

  .photo {
    position: relative;
    padding: 6px 20px 20px 6px;
  }

  .photo::after {
    content: '';
    position: absolute;
    inset: 6px 20px 20px 6px;
    border: 2px solid var(--acc);
    transform: translate(14px, 14px);
    transition: transform 0.3s ease;
  }

  .photo:hover::after {
    transform: translate(20px, 20px);
  }

  .shot {
    position: relative;
    z-index: 1;
    background: var(--acc);
    aspect-ratio: 1.68;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
  }

  .photo:hover .shot {
    transform: translate(-4px, -4px);
    background-color: #fff;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
    transition: filter 0.3s ease;
  }

  .photo:hover .shot :global(img) {
    filter: none;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .eye {
    margin: 0 0 14px 6px;
  }

  .name {
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin: 0 0 12px;
  }

  .desc {
    max-width: 560px;
    margin: 0 0 20px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
  }

  .stack span {
    border: 1px solid var(--line);
    padding: 7px 12px;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .actions {
    display: flex;
    gap: 12px;
  }

  .pbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 11px 24px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.65;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    transition:
      border-color 0.15s,
      background 0.15s;

    &:hover {
      border-color: var(--ink);
    }
  }

  .pbtn.f {
    background: var(--acc);
    border-color: var(--acc);
    color: var(--on);

    &:hover {
      background: var(--hover);
      border-color: var(--hover);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo::after,
    .shot,
    .shot :global(img) {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .also {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 56px;
      padding-top: 36px;
    }

    .left {
      margin-bottom: 24px;
    }

    .photo {
      padding: 4px 22px 22px 4px;
    }

    .photo::after {
      inset: 4px 22px 22px 4px;
      transform: translate(18px, 18px);
    }

    .photo:hover::after {
      transform: translate(22px, 22px);
    }

    .name {
      font-size: 26px;
    }

    .desc {
      font-size: 16px;
      margin: 0 0 18px;
    }

    .stack {
      flex-wrap: nowrap;
      gap: 6px;
      margin: 0 0 22px;
    }

    .stack span {
      font-size: 11px;
      letter-spacing: 0.06em;
      padding: 6px 9px;
    }

    .actions {
      width: 100%;
    }

    .pbtn {
      flex: 1 1 auto;
      font-size: 15px;
      padding: 11px 14px;
    }

    .pbtn.f {
      flex: 1.4 1 auto;
    }
  }
</style>
