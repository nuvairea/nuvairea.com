---
interface Props {
  icon: 'github' | 'discord' | 'instagram' | 'x';
  label: string;
  value: string;
  href: string;
}

const { icon, label, value, href } = Astro.props;
const viewBox = icon === 'github' ? '0 0 16 16' : '0 0 24 24';
---

<a class="row" href={href}>
  <div class="ic">
    <svg aria-hidden="true" viewBox={viewBox}>
      <use href={`/icons/${icon}.svg#icon`} />
    </svg>
  </div>
  <div><b>{label}</b><span>{value}</span></div>
</a>

<style>
  .row {
    display: flex;
    gap: 26px;
    align-items: center;
    padding: 30px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .ic {
    width: 62px;
    height: 62px;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    flex: none;
    color: var(--acc);
  }

  .row:hover .ic {
    background: var(--acc);
    color: var(--on);
    border-color: var(--acc);
  }

  .ic svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }

  .row b {
    display: block;
    font-size: 22px;
    font-weight: 500;
  }

  .row span {
    color: var(--mute);
    font-size: 18px;
    font-weight: 300;
    word-break: break-all;
  }

  @media (max-width: 640px) {
    .row {
      gap: 18px;
      padding: 22px 0;
    }

    .ic {
      width: 52px;
      height: 52px;
    }

    .ic svg {
      width: 24px;
      height: 24px;
    }

    .row b {
      font-size: 19px;
    }

    .row span {
      font-size: 15px;
    }
  }
</style>
