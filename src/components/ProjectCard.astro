---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class='eye'>Featured project</div>
<h2 class='name'>{project.name}</h2>

<div class='shot'>
  <Image
    src={project.screenshot.src}
    alt={project.screenshot.alt}
    widths={[800, 1200, 2000]}
    sizes='(min-width: 1040px) 992px, 100vw'
  />
</div>

<p class='desc lead'>{project.description}</p>
<div class='stack'>
  {project.stack.map((item) => <span>{item}</span>)}
</div>

<div class='actions'>
  <a class='pbtn f' href={project.liveUrl} target='_blank' rel='noopener noreferrer'>
    <svg aria-hidden='true' viewBox='0 0 24 24' width='18' height='18' fill='currentColor'>
      <use href='/icons/external.svg#icon'></use>
    </svg>
    <span class='lbl'>Visit {project.name}</span>
  </a>
  <a class='pbtn' href={project.codeUrl} target='_blank' rel='noopener noreferrer'>
    <svg aria-hidden='true' viewBox='0 0 16 16' width='18' height='18' fill='currentColor'>
      <use href='/icons/github.svg#icon'></use>
    </svg>
    <span class='lbl'>View code</span>
  </a>
</div>

<style>
  .name {
    letter-spacing: -0.045em;
    margin: 22px 0 24px;
    line-height: 1.05;
  }

  .shot {
    margin: 0 0 32px;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--line);
  }

  .desc {
    max-width: 640px;
    margin: 0 0 26px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 30px;
  }

  .stack span {
    border: 1px solid var(--line);
    padding: 9px 16px;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .actions {
    display: flex;
    gap: 12px;
    max-width: 560px;
  }

  .pbtn {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 18px;
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.65;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--line);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s,
      color 0.15s;

    &:hover {
      border-color: var(--ink);
    }
  }

  .pbtn.f {
    background: var(--acc);
    border-color: var(--acc);
    color: var(--on);

    &:hover {
      background: var(--hover);
      border-color: var(--hover);
    }
  }

  @media (max-width: 640px) {
    .name {
      font-size: 36px;
    }

    .shot {
      margin-bottom: 24px;
    }

    .desc {
      font-size: 16px;
      margin: 0 0 20px;
    }

    .stack {
      gap: 8px;
      margin: 0 0 22px;
    }

    .stack span {
      font-size: 12px;
      padding: 4px 10px;
    }

    .pbtn {
      font-size: 15px;
      padding: 11px 14px;
    }
  }

  @media (max-width: 520px) {
    .pbtn:not(.f) {
      flex: 0 0 52px;
      padding-inline: 0;
    }

    .pbtn:not(.f) .lbl {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
