---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const primaryLink = project.links[0];
---

<div class='eye'>Featured project</div>
<div class='lab'>{project.tagline}</div>
<div class='title'>
  <h3>{project.name}</h3>
  <a href={primaryLink.href} aria-label={`Open ${project.name}`}>→</a>
</div>
<div class='pills'>
  {project.pills.map((pill) => <span class:list={['pill', { live: pill.live }]}>{pill.label}</span>)}
</div>
<p class='desc lead'>{project.description}</p>
<div class='stack'>
  {project.stack.map((item) => <span>{item}</span>)}
</div>
<div class='ul'>
  {project.links.map((link) => <a href={link.href}>{link.label}</a>)}
</div>

<style>
  .lab {
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 34px 0 10px;
  }

  .title {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .title h3 {
    font-size: clamp(40px, 7vw, 68px);
    font-weight: 400;
    letter-spacing: -0.045em;
    margin: 0;
    line-height: 1.05;
  }

  .title a {
    color: var(--acc);
    font-size: 38px;
    text-decoration: none;
  }

  .pills {
    display: flex;
    gap: 10px;
    margin: 18px 0 22px;
  }

  .pill {
    border: 1px solid var(--line);
    padding: 6px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: var(--bg2);
  }

  .pill.live {
    color: var(--acc);
    border-color: var(--acc);
  }

  .desc {
    max-width: 640px;
    margin: 0 0 26px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 30px;
  }

  .stack span {
    border: 1px solid var(--line);
    padding: 9px 16px;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }

  .ul a {
    font-weight: 600;
    font-size: 17px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: var(--acc);
    transition: color 0.15s;

    &:hover {
      color: var(--mute);
    }
  }

  @media (max-width: 640px) {
    .lab {
      font-size: 13px;
      margin: 24px 0 8px;
    }

    .title h3 {
      font-size: 36px;
    }

    .title a {
      font-size: 30px;
    }

    .pills {
      gap: 8px;
      margin: 14px 0 18px;
    }

    .pill {
      font-size: 12px;
      padding: 4px 10px;
    }

    .desc {
      font-size: 16px;
      margin: 0 0 20px;
    }

    .stack {
      gap: 8px;
      margin: 0 0 22px;
    }

    .stack span {
      font-size: 12px;
      padding: 4px 10px;
    }

    .ul {
      gap: 10px 24px;
    }

    .ul a {
      font-size: 15px;
    }
  }
</style>
