---
import About from '../components/About.astro';
import ConnectRow from '../components/ConnectRow.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
import projects from '../data/projects';
---

<Layout>
  <Header />
  <main id="top">
    <section class="hero">
      <div class="w">
        <div class="eye">Developer. Craftsman. Builder.</div>
        <h1>I build the whole thing, <b>front to back.</b></h1>
        <p class="sub lead">I'm Paul. I create practical software, thoughtful interfaces, and the backends behind them.</p>
        <div class="btns">
          <a class="btn f" href="#projects">See my work</a><a class="btn" href="#connect">Get in touch</a>
        </div>
      </div>
    </section>

    <About />

    <section class="sec" id="projects">
      <div class="w reveal">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="sec conn" id="connect">
      <div class="w reveal">
        <div class="eye">Connect</div>
        <h2 class="connect-heading">Find me <b>online.</b></h2>
        <p class="sub lead">Code, projects and the occasional update. Say hi on either.</p>
        <ConnectRow
          icon="github"
          label="GitHub"
          value="@nuvairea"
          href="https://github.com/nuvairea"
        />
        <ConnectRow
          icon="email"
          label="Email"
          value="nuvairea@gmail.com"
          href="mailto:nuvairea@gmail.com"
        />
      </div>
    </section>

    <section class="cta">
      <div class="w reveal">
        <h2>Need something built? Let's make it real.</h2>
        <a href="mailto:nuvairea@gmail.com">Hit me up →</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    padding: 84px 0 92px;
    background: linear-gradient(180deg, var(--bg), var(--bg2));
  }

  .sub {
    max-width: 560px;
    margin: 0 0 38px;
  }

  .btns {
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    max-width: 480px;
  }

  .btn {
    flex: 1 1 0;
    text-align: center;
    white-space: nowrap;
    padding: 13px 10px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--line);
    font-size: 16px;
    transition: border-color 0.15s;

    &:hover {
      border-color: var(--ink);
    }
  }

  .btn.f {
    background: var(--acc);
    border-color: var(--acc);
    color: var(--on);
  }

  .sec {
    padding: 84px 0;
    border-top: 1px solid var(--line);
  }

  .conn {
    background: var(--bg2);
  }

  .connect-heading {
    margin-top: 22px;
  }

  .conn p.sub {
    margin: 28px 0 48px;
  }

  .cta {
    background: var(--acc);
    color: var(--bg);
    padding: 96px 0;
  }

  .cta h2 {
    max-width: 780px;
  }

  .cta a {
    display: inline-block;
    margin-top: 44px;
    font-size: 22px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 3px solid var(--bg);
    padding-bottom: 12px;
  }

  @media (max-width: 640px) {
    .sec {
      padding: 56px 0;
    }

    .hero p {
      font-size: 17px;
    }

    .conn p.sub {
      font-size: 17px;
      margin: 20px 0 32px;
    }

    .cta {
      padding: 64px 0;
    }

    .cta a {
      font-size: 19px;
      margin-top: 32px;
      padding-bottom: 10px;
    }
  }
</style>
